# Data files (large)
MR/
VMP/
AtomixData
bench_tests/
bench/
benchmarks/

# Microstructure sensor calibration sheets (local reference PDFs)
microstructure_sensors/*

# Per-cruise data directories — only the YAML config is tracked.
ARCTERX/*
!ARCTERX/perturb.yaml

# Local ARCTERX 2023 Wake workspace (inputs and generated products).
ARCTERX-2023-Wake/

# Rockland ODAS MATLAB reference (third-party)
odas/

# Reference papers (large PDFs; the README indexes ARE tracked — an ignored
# DIRECTORY is never descended into, hence the ** + unignore pattern)
papers/**
!papers/**/
!papers/**/README.md

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
*.so

# Testing / IDE
.pytest_cache/
.benchmarks/
.coverage
htmlcov/

# Environment
.env
.venv/

# Claude Code
.claude/

# Local run artifacts and example data (large; not tracked)
examples/*/tpw/
myout/
results/
!microstructure_sensors/shear_sensitivities.csv
!microstructure_sensors/README.md

# Local scratch for exploratory analysis (see scripts/ for the kept drivers)
scratch/

# Rutgers RU33 MicroRider workspace — only the configs and the README are
# tracked; the .p files, hotel.nc and results are not (about 1 GB).
Rutgers/*
!Rutgers/*.yaml
!Rutgers/README.md
# An ignored DIRECTORY is never descended into, so the earlier single-file
# run's configs need their directory unignored before its *.yaml can be.
!Rutgers/dat_0377/
Rutgers/dat_0377/*
!Rutgers/dat_0377/*.yaml
